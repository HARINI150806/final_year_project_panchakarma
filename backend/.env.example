# Copy this file to .env for local development.
# In Render, add these values under the backend service Environment settings.
DB_URL=jdbc:postgresql://localhost:5432/panchakarma_management
DB_USERNAME=postgres
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain

# Gmail SMTP: use a Google App Password, not the normal account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=your-16-character-app-password

# Optional integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_MEET_DEFAULT_LINK=
GEMINI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CONSULTATION_AMOUNT=500.00
