# ============================================================
# ENVIRONMENT & SECRETS (NEVER COMMIT THESE)
# ============================================================
.env
.env.local
.env.production
.env.staging
backend/.env
backend/.env.*
frontend/.env
frontend/.env.local
frontend/.env.production

