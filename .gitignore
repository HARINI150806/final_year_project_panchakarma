# JAVA / MAVEN (Backend)
# ============================================================
backend/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Maven wrapper
backend/.mvn/wrapper/maven-wrapper.jar

# Spring Boot logs
*.log
logs/

# ============================================================
# NODE / NPM / VITE (Frontend)
# ============================================================
frontend/node_modules/
frontend/dist/
