node_modules/
dist/

# NPM debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# UPLOADS (User-uploaded files - runtime data)
# ============================================================
uploads/
backend/uploads/

