.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/*.code-workspace
!.vscode/extensions.json

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
.factorypath

# NetBeans
nbproject/

